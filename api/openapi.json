{
  "openapi": "3.1.1",
  "info": {
    "title": "Jayburd Ledger Contract",
    "version": "0.1.0-draft",
    "description": "Review artifact only; no server exists. SQL/accounting contracts remain authoritative for semantic validation. Not a registered ISO financial-message definition.",
    "contact": {
      "name": "Jayburd contract review",
      "url": "https://github.com/justin-napolitano/jayburd-bookkeeping/issues/2"
    }
  },
  "servers": [
    {
      "url": "https://bookkeeping.example.invalid",
      "description": "Non-routable documentation placeholder; no deployed endpoint."
    }
  ],
  "tags": [
    {
      "name": "Ledger",
      "description": "Authorized bookkeeping operations within one entity/book."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/entities/{entity_id}/books/{book_id}/journals": {
      "parameters": [
        {
          "name": "entity_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "book_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "postJournal",
        "summary": "Post one balanced manual journal",
        "tags": [
          "Ledger"
        ],
        "x-required-permission": "post",
        "responses": {
          "201": {
            "description": "Committed result.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                },
                "description": "Financial responses are not cacheable."
              },
              "Idempotent-Replay": {
                "schema": {
                  "type": "boolean"
                },
                "description": "True when returning an existing successful receipt; false for first execution."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Journal"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem400"
          },
          "401": {
            "$ref": "#/components/responses/Problem401"
          },
          "403": {
            "$ref": "#/components/responses/Problem403"
          },
          "404": {
            "$ref": "#/components/responses/Problem404"
          },
          "409": {
            "$ref": "#/components/responses/Problem409"
          },
          "413": {
            "$ref": "#/components/responses/Problem413"
          },
          "422": {
            "$ref": "#/components/responses/Problem422"
          },
          "503": {
            "$ref": "#/components/responses/Problem503"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostJournal"
              },
              "example": {
                "expected_revision": "0",
                "policy_id": "00000000-0000-4000-8000-000000000010",
                "accounting_date": "2026-01-01",
                "description": "Synthetic opening capital",
                "lines": [
                  {
                    "account_id": "00000000-0000-4000-8000-000000000011",
                    "side": "debit",
                    "transaction_currency": "USD",
                    "transaction_amount": "1000.00",
                    "functional_amount": "1000.00",
                    "valuation_basis": "identity"
                  },
                  {
                    "account_id": "00000000-0000-4000-8000-000000000012",
                    "side": "credit",
                    "transaction_currency": "USD",
                    "transaction_amount": "1000.00",
                    "functional_amount": "1000.00",
                    "valuation_basis": "identity"
                  }
                ]
              }
            }
          }
        }
      }
    },
