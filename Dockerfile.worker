# Explicit source-only copies prevent credentials or runtime evidence entering image layers.
FROM golang:1.26.10-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/ ./internal/
COPY cmd/worker/ ./cmd/worker/
COPY cmd/sandbox-probe/ ./cmd/sandbox-probe/
COPY cmd/deliver/ ./cmd/deliver/
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /worker ./cmd/worker
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /deliver ./cmd/deliver
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /sandbox-probe ./cmd/sandbox-probe
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /worker /worker
COPY --from=build /deliver /deliver
COPY --from=build /sandbox-probe /sandbox-probe
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/worker"]
# Mode and nonsecret binding identifiers must be explicitly supplied by reviewed deployment config.
CMD ["-listen=0.0.0.0:8080"]
