{
  "name": "jayburd-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test -c playwright-ct.config.ts",
    "api:generate": "openapi-typescript ../api/openapi.json -o src/lib/api.generated.ts",
    "api:check": "openapi-typescript ../api/openapi.json -o src/lib/api.generated.ts --check",
    "format": "prettier --write src/bookkeeping src/app tests playwright *.ts package.json"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "vitest": "5.0.3",
    "jsdom": "27.4.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@playwright/experimental-ct-react": "1.62.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
