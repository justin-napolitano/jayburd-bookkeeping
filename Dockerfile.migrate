# Only reviewed Go/SQL artifacts enter the migration image; no runtime credentials or config.
FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/clouddb/ ./internal/clouddb/
COPY internal/migration/ ./internal/migration/
COPY db/migrations/ ./db/migrations/
COPY cmd/migrate/ ./cmd/migrate/
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /migrate ./cmd/migrate
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /migrate /migrate
USER 65532:65532
ENTRYPOINT ["/migrate"]
CMD ["-action=verify"]
