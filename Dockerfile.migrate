# Only reviewed Go/SQL artifacts enter the migration image; no runtime credentials or config.
FROM golang:1.26.10-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/clouddb/ ./internal/clouddb/
COPY internal/migration/ ./internal/migration/
COPY db/migrations/ ./db/migrations/
COPY cmd/migrate/ ./cmd/migrate/
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /migrate ./cmd/migrate
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /migrate /migrate
USER 65532:65532
ENTRYPOINT ["/migrate"]
CMD ["-action=verify"]
